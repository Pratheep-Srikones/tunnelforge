[Unit]
Description=TunnelForge Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tunnelforge
Group=tunnelforge
WorkingDirectory=/etc/tunnelforge
ExecStart=/usr/local/bin/tunnelforge-server
Restart=always
RestartSec=5
Environment="FORGE_ENROLLMENT_KEY=your_secure_enrollment_key_here"
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
